    local function updateLogDisplay()
        local displayText = ""
        local maxDisplay = 50
        local startIndex = math.max(1, #_G.RemoteSpyData - maxDisplay + 1)
        
        for i = startIndex, #_G.RemoteSpyData do
            local log = _G.RemoteSpyData[i]
            displayText = displayText .. string.format("[%s] %s\n", log.Time, log.Name)
            displayText = displayText .. string.format("Args: %s\n\n", log.Args)
        end
        
        if displayText == "" then
            logText.Text = "Waiting for activity..."
        else
            logText.Text = displayText
        end
        
        logText.Size = UDim2.new(1, -10, 0, math.max(220, #displayText / 3))
        scrollFrame.CanvasSize = UDim2.new(0, 0, 0, logText.AbsoluteSize.Y)
        scrollFrame.CanvasPosition = Vector2.new(0, scrollFrame.AbsoluteCanvasSize.Y)
    end
    
    local function startSpy()
        _G.RemoteSpyActive = true
        
        for _, remote in pairs(game:GetDescendants()) do
            if remote:IsA("RemoteEvent") then
                remote.OnClientEvent:Connect(function(...)
                    if _G.RemoteSpyActive then
                        local args = {...}
                        local argsStr = ""
                        
                        for i, arg in ipairs(args) do
                            if typeof(arg) == "Instance" then
                                argsStr = argsStr .. tostring(arg.Name)
                            else
                                argsStr = argsStr .. tostring(arg)
                            end
                            
                            if i < #args then
                                argsStr = argsStr .. ", "
                            end
                        end
                        
                        local logEntry = {
                            Type = "RemoteEvent",
                            Name = remote.Name,
                            Path = remote:GetFullName(),
                            Args = argsStr,
                            Time = os.date("%H:%M:%S")
                        }
                        
                        table.insert(_G.RemoteSpyData, logEntry)
                        
                        print("🔴 RemoteEvent:", remote.Name, "→", argsStr)
                        
                        updateLogDisplay()
                        statusLabel.Text = string.format("Status: Active | Logs: %d", #_G.RemoteSpyData)
                    end
                end)
            end
            
            if remote:IsA("RemoteFunction") then
                local oldInvoke = remote.OnClientInvoke
                
                remote.OnClientInvoke = function(...)
                    if _G.RemoteSpyActive then
                        local args = {...}
                        local argsStr = ""
                        
                        for i, arg in ipairs(args) do
                            if typeof(arg) == "Instance" then
                                argsStr = argsStr .. tostring(arg.Name)
                            else
                                argsStr = argsStr .. tostring(arg)
                            end
                            
                            if i < #args then
                                argsStr = argsStr .. ", "
                            end
                        end
                        
                        local logEntry = {
                            Type = "RemoteFunction",
                            Name = remote.Name,
                            Path = remote:GetFullName(),
                            Args = argsStr,
                            Time = os.date("%H:%M:%S")
                        }
                        
                        table.insert(_G.RemoteSpyData, logEntry)
                        
                        print("🔵 RemoteFunction:", remote.Name, "→", argsStr)
                        
                        updateLogDisplay()
                        statusLabel.Text = string.format("Status: Active | Logs: %d", #_G.RemoteSpyData)
                    end
                    
                    if oldInvoke then
                        return oldInvoke(...)
                    end
                end
            end
        end
    end
    
