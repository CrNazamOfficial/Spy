_G.RemoteSpyActive = false

local HttpService = game:GetService("HttpService")

local function saveSpy()
    if #_G.RemoteSpyData > 0 then
        local timestamp = os.date("%Y%m%d_%H%M%S")
        local output = "REMOTE SPY LOG\n" .. string.rep("=", 40) .. "\n\n"
        
        for _, log in ipairs(_G.RemoteSpyData) do
            output = output .. string.format("[%s] %s: %s\nArgs: %s\n%s\n", log.Time, log.Type, log.Name, log.Args, string.rep("-", 40))
        end
        
        writefile("REMOTE_SPY_" .. timestamp .. ".txt", output)
        writefile("REMOTE_SPY_" .. timestamp .. ".json", HttpService:JSONEncode(_G.RemoteSpyData))
        print("Remote Spy saved!")
    end
end

