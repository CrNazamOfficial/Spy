    local function updateLog()
        local displayText = ""
        for i = math.max(1, #_G.RemoteSpyData - 50), #_G.RemoteSpyData do
            local log = _G.RemoteSpyData[i]
            displayText = displayText .. string.format("[%s] %s\nArgs: %s\n\n", log.Time, log.Name, log.Args)
        end
        logText.Text = displayText ~= "" and displayText or "Waiting for activity..."
        logText.Size = UDim2.new(1, -10, 0, math.max(220, #displayText / 3))
        scrollFrame.CanvasSize = UDim2.new(0, 0, 0, logText.AbsoluteSize.Y)
        scrollFrame.CanvasPosition = Vector2.new(0, scrollFrame.AbsoluteCanvasSize.Y)
    end
    
    local function startSpy()
        _G.RemoteSpyActive = true
        
        for _, remote in pairs(game:GetDescendants()) do
            if remote:IsA("RemoteEvent") then
                remote.OnClientEvent:Connect(function(...)
                    if not _G.RemoteSpyActive then return end
                    
                    local args = {...}
                    local argsStr = ""
                    for i, arg in ipairs(args) do
                        argsStr = argsStr .. (typeof(arg) == "Instance" and arg.Name or tostring(arg))
                        if i < #args then argsStr = argsStr .. ", " end
                    end
                    
                    table.insert(_G.RemoteSpyData, {
                        Type = "RemoteEvent",
                        Name = remote.Name,
                        Path = remote:GetFullName(),
                        Args = argsStr,
                        Time = os.date("%H:%M:%S")
                    })
                    
                    print("🔴", remote.Name, "→", argsStr)
                    updateLog()
                    statusLabel.Text = string.format("Status: Active | Logs: %d", #_G.RemoteSpyData)
                end)
            end
        end
    end
    
    toggleBtn.MouseButton1Click:Connect(function()
        if not _G.RemoteSpyActive then
            startSpy()
            toggleBtn.Text = "STOP SPY"
            toggleBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
            toggleBtn.BackgroundColor3 = Color3.fromRGB(50, 15, 15)
        else
            _G.RemoteSpyActive = false
            toggleBtn.Text = "START SPY"
            toggleBtn.TextColor3 = Color3.fromRGB(100, 255, 100)
            toggleBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
        end
    end)
    
    saveBtn.MouseButton1Click:Connect(function()
        saveSpy()
        saveBtn.Text = "SAVED!"
        wait(1)
        saveBtn.Text = "SAVE LOG"
    end)
    
    clearBtn.MouseButton1Click:Connect(function()
        _G.RemoteSpyData = {}
        logText.Text = "Waiting for activity..."
        statusLabel.Text = "Status: Ready | Logs: 0"
    end)
end

