local function saveSpyData()
    if #_G.RemoteSpyData > 0 then
        local timestamp = os.date("%Y%m%d_%H%M%S")
        local filename = "REMOTE_SPY_" .. timestamp .. ".txt"
        
        local output = "================================\n"
        output = output .. "REMOTE SPY LOG\n"
        output = output .. "Game: " .. game.Name .. "\n"
        output = output .. "Place ID: " .. game.PlaceId .. "\n"
        output = output .. "Date: " .. os.date("%Y-%m-%d %H:%M:%S") .. "\n"
        output = output .. "================================\n\n"
        
        for i, log in ipairs(_G.RemoteSpyData) do
            output = output .. string.format("[%s] %s: %s\n", log.Time, log.Type, log.Name)
            output = output .. "Path: " .. log.Path .. "\n"
            output = output .. "Arguments: " .. log.Args .. "\n"
            output = output .. "--------------------------------\n"
        end
        
        writefile(filename, output)
        
        local jsonFilename = "REMOTE_SPY_" .. timestamp .. ".json"
        writefile(jsonFilename, HttpService:JSONEncode(_G.RemoteSpyData))
        
        print("Remote Spy saved to:", filename)
        print("JSON saved to:", jsonFilename)
    end
end

