    local function updateLogDisplay()
        local displayText = ""
        local maxDisplay = 30
        local startIndex = math.max(1, #_G.RemoteSpyData - maxDisplay + 1)
        
        for i = startIndex, #_G.RemoteSpyData do
            local log = _G.RemoteSpyData[i]
            displayText = displayText .. string.format("[%s] %s: %s\n", log.Time, log.Type, log.Name)
            if log.Args and log.Args ~= "" then
                displayText = displayText .. string.format("Args: %s\n", log.Args)
            end
            displayText = displayText .. "\n"
        end
        
        if displayText == "" then
            if _G.RemoteSpyActive then
                logText.Text = "Monitoring... No events yet."
            else
                logText.Text = "Click START to begin monitoring..."
            end
        else
            logText.Text = displayText
        end
        
        logText.Size = UDim2.new(1, -6, 0, math.max(110, #displayText / 1.5))
        scrollFrame.CanvasSize = UDim2.new(0, 0, 0, logText.AbsoluteSize.Y)
        scrollFrame.CanvasPosition = Vector2.new(0, scrollFrame.AbsoluteCanvasSize.Y)
    end

    local spyConnections = {}
    
    local function startSpy()
        _G.RemoteSpyActive = true
        logText.Text = "Monitoring... Scanning for remotes..."
        
        local remoteCount = 0
        
        for _, remote in pairs(game:GetDescendants()) do
            if remote:IsA("RemoteEvent") then
                remoteCount = remoteCount + 1
                local connection = remote.OnClientEvent:Connect(function(...)
                    if _G.RemoteSpyActive then
                        local args = {...}
                        local argsStr = ""
                        
                        for i, arg in ipairs(args) do
                            if typeof(arg) == "Instance" then
                                argsStr = argsStr .. tostring(arg.Name)
                            elseif typeof(arg) == "table" then
                                argsStr = argsStr .. "{table}"
                            else
                                argsStr = argsStr .. tostring(arg)
                            end
                            
                            if i < #args then
                                argsStr = argsStr .. ", "
                            end
                        end
                        
                        local logEntry = {
                            Type = "RemoteEvent",
                            Name = remote.Name,
                            Path = remote:GetFullName(),
                            Args = argsStr,
                            Time = os.date("%H:%M:%S")
                        }
                        
                        table.insert(_G.RemoteSpyData, logEntry)
                        
                        print("🔴 RemoteEvent:", remote.Name, "→", argsStr)
                        
                        updateLogDisplay()
                        statusLabel.Text = string.format("Logs: %d | Status: Active", #_G.RemoteSpyData)
                    end
                end)
                table.insert(spyConnections, connection)
            end
            
            if remote:IsA("RemoteFunction") then
                remoteCount = remoteCount + 1
                local oldInvoke = remote.OnClientInvoke
                
                remote.OnClientInvoke = function(...)
                    if _G.RemoteSpyActive then
                        local args = {...}
                        local argsStr = ""
                        
                        for i, arg in ipairs(args) do
                            if typeof(arg) == "Instance" then
                                argsStr = argsStr .. tostring(arg.Name)
                            elseif typeof(arg) == "table" then
                                argsStr = argsStr .. "{table}"
                            else
                                argsStr = argsStr .. tostring(arg)
                            end
                            
                            if i < #args then
                                argsStr = argsStr .. ", "
                            end
                        end
                        
                        local logEntry = {
                            Type = "RemoteFunction",
                            Name = remote.Name,
                            Path = remote:GetFullName(),
                            Args = argsStr,
                            Time = os.date("%H:%M:%S")
                        }
                        
                        table.insert(_G.RemoteSpyData, logEntry)
                        
                        print("🔵 RemoteFunction:", remote.Name, "→", argsStr)
                        
                        updateLogDisplay()
                        statusLabel.Text = string.format("Logs: %d | Status: Active", #_G.RemoteSpyData)
                    end
                    
                    if oldInvoke then
                        return oldInvoke(...)
                    end
                end
            end
        end
        
        logText.Text = string.format("Monitoring %d remotes...\nWaiting for events...", remoteCount)
        updateLogDisplay()
    end
    
    local function stopSpy()
        _G.RemoteSpyActive = false
        
        for _, connection in pairs(spyConnections) do
            if connection then
                connection:Disconnect()
            end
        end
        spyConnections = {}
    end
    
